<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:vm="using:RSTechAppTest.ViewModels"
		xmlns:models="using:RSTechAppTest.Models"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="RSTechAppTest.Views.MainWindow"
		x:DataType="vm:MainViewModel"
        Title="RSTechAppTest">


	<Grid RowDefinitions="Auto, *, Auto" Margin="15">

		<!-- Верхняя панель: Ввод новой задачи -->
		<Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,15">
			<TextBox Grid.Column="0"
                     Text="{Binding NewTaskTitle, Mode=TwoWay}"
                     PlaceholderText="Введите название задачи и нажмите Enter..."
                     VerticalContentAlignment="Center"
                     Margin="0,0,10,0">
				<TextBox.KeyBindings>
					<KeyBinding Gesture="Enter" Command="{Binding AddTaskCommand}"/>
				</TextBox.KeyBindings>
			</TextBox>
			<Button Grid.Column="1"
                    Content="Добавить"
                    Command="{Binding AddTaskCommand}"/>
		</Grid>

		<!-- Центральная часть: Таблица задач -->
		<DataGrid Grid.Row="1"
				  ItemsSource="{Binding Tasks}"
				  AutoGenerateColumns="False"
				  CanUserResizeColumns="True"
				  GridLinesVisibility="All"
				  BorderThickness="1"
				  BorderBrush="Gray">
			<DataGrid.Columns>
				<!-- Чекбокс выполнения -->
				<DataGridTemplateColumn Header="Статус" Width="80">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate x:DataType="models:TaskItem">
							<CheckBox IsChecked="{Binding IsCompleted, Mode=TwoWay}"
									  HorizontalAlignment="Center"
									  Command="{Binding $parent[DataGrid].DataContext.ToggleCompletionCommand}"
									  CommandParameter="{Binding}"/>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<!-- Название задачи -->
				<DataGridTextColumn Header="Задача"
									Binding="{Binding Title}"
									Width="*"/>

				<!-- Дата создания -->
				<DataGridTextColumn Header="Создано"
									Binding="{Binding CreatedAt, StringFormat=\{0:dd.MM.yyyy HH:mm\}}"
									IsReadOnly="True"
									Width="140"/>

				<!-- Действия -->
				<DataGridTemplateColumn Header="Действия" Width="90">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate x:DataType="models:TaskItem">
							<Button Content="Удалить"
									Foreground="Red"
									Background="Transparent"
									HorizontalAlignment="Center"
									Command="{Binding $parent[DataGrid].DataContext.DeleteTaskCommand}"
									CommandParameter="{Binding}"/>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
			</DataGrid.Columns>
		</DataGrid>


		<!-- Нижняя панель: Текст ошибки -->
		<Border Grid.Row="2"
                Background="#FDE8E8"
                BorderBrush="Red"
                BorderThickness="1"
                CornerRadius="4"
                Margin="0,10,0,0"
                Padding="10"
                IsVisible="{Binding HasError}">
			<TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap"/>
		</Border>
	</Grid>
</Window>
